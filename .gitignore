# ============================================================
# .gitignore — Crop Disease Identification Project
# ============================================================

# Secrets — NEVER commit
.env

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/

# ML Model binaries (except bundled core models)
models/*.pkl
models/*.keras
*.keras
*.pkl
!models/tomato_multiclass_model.h5
!models/banana_multiclass_model.h5

# Uploaded images (runtime artefacts)
static/uploads/

# Logs
logs/

# Datasets (large directories)
dataset/
dataset_banana/
crop_classifier_dataset/

# Research variants (experimental, not part of main app)
Variant-b(MultiLabel Classification)/
Variant-c(Object Detection)/

# Unnamed folders
New folder/

# OS artefacts
.DS_Store
Thumbs.db
desktop.ini

# Editor artefacts
.vscode/
.idea/
*.swp
*.swo

# Pytest cache
.pytest_cache/
.coverage
htmlcov/

# Build artefacts
dist/
build/
*.egg-info/
